# AIGPMS Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── Database ────────────────────────────────────────────────────────────────
# Development (SQLite — fast local start)
DATABASE_URL=sqlite:///./aigpms.db

# Production (PostgreSQL — use this when deploying)
# DATABASE_URL=postgresql://aigpms_user:YOUR_PASSWORD@localhost:5432/aigpms_db

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ─── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME=AIGPMS
ENVIRONMENT=development

# ─── Alert Configuration ─────────────────────────────────────────────────────
# Comma-separated days before cheque date to trigger alerts
PDC_ALERT_DAYS=30,14,7,3

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
